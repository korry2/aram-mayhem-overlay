<Window x:Class="AramMayhemOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARAM Mayhem Overlay Settings"
        Width="460"
        Height="390"
        MinWidth="420"
        MinHeight="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Overlay Settings"
            FontSize="24"
            FontWeight="SemiBold"/>

        <Grid
            Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Opacity"
                VerticalAlignment="Center"
                FontSize="14"/>

            <Slider
                x:Name="OpacitySlider"
                Grid.Column="1"
                Minimum="0.10"
                Maximum="1.00"
                SmallChange="0.05"
                LargeChange="0.10"
                VerticalAlignment="Center"
                ValueChanged="OpacitySlider_ValueChanged"/>

            <TextBlock
                x:Name="OpacityValueText"
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="14"/>
        </Grid>

        <Grid
            Grid.Row="3"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Width"
                VerticalAlignment="Center"
                FontSize="14"/>

            <TextBox
                x:Name="WidthTextBox"
                Grid.Column="1"
                Height="32"
                Padding="8"
                VerticalContentAlignment="Center"/>
        </Grid>

        <Grid
            Grid.Row="4"
            Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Height"
                VerticalAlignment="Center"
                FontSize="14"/>

            <TextBox
                x:Name="HeightTextBox"
                Grid.Column="1"
                Height="32"
                Padding="8"
                VerticalContentAlignment="Center"/>
        </Grid>

        <Grid
            Grid.Row="5"
            Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Input mode"
                VerticalAlignment="Center"
                FontSize="14"/>

            <ComboBox
                x:Name="InputModeComboBox"
                Grid.Column="1"
                Height="32"/>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="6"
            Margin="0,18,0,0"
            Foreground="DarkRed"
            TextWrapping="Wrap"/>

        <Grid
            Grid.Row="7"
            Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="120"
                Height="34"
                Content="Reset Defaults"
                Click="ResetButton_Click"/>

            <Button
                Grid.Column="2"
                Width="90"
                Height="34"
                Margin="8,0,0,0"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click"/>

            <Button
                Grid.Column="3"
                Width="90"
                Height="34"
                Margin="8,0,0,0"
                Content="Save"
                IsDefault="True"
                Click="SaveButton_Click"/>
        </Grid>

    </Grid>
</Window>
<Window x:Class="AramMayhemOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARAM Mayhem Overlay"
        Width="380"
        Height="250"
        MinWidth="320"
        MinHeight="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True">

    <Border
        Margin="10"
        Padding="20"
        Background="#E61A1A1A"
        CornerRadius="16"
        BorderBrush="#40FFFFFF"
        BorderThickness="1"
        MouseLeftButtonDown="OverlayBorder_MouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="ARAM MAYHEM"
                Foreground="White"
                FontSize="22"
                FontWeight="SemiBold"/>

            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Text="●"
                Foreground="#80FFFFFF"
                FontSize="18"
                VerticalAlignment="Center"/>

            <TextBlock
                x:Name="ChampionNameText"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,14,0,0"
                Foreground="White"
                FontSize="18"
                FontWeight="SemiBold"/>

            <TextBlock
                x:Name="LevelText"
                Grid.Row="1"
                Grid.Column="1"
                Margin="16,14,0,0"
                Foreground="#D9FFFFFF"
                FontSize="14"
                VerticalAlignment="Center"/>

            <TextBlock
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,14,0,0"
                Text="HEALTH"
                Foreground="#90FFFFFF"
                FontSize="11"
                FontWeight="SemiBold"/>

            <Grid
                Grid.Row="3"
                Grid.ColumnSpan="2"
                Margin="0,5,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar
                    x:Name="HealthBar"
                    Grid.Column="0"
                    Height="10"
                    Minimum="0"
                    Maximum="1"
                    Value="0.5"/>

                <TextBlock
                    x:Name="HealthText"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Foreground="White"
                    FontSize="13"
                    VerticalAlignment="Center"/>
            </Grid>

            <Border
                Grid.Row="4"
                Grid.ColumnSpan="2"
                Margin="0,16,0,0"
                Padding="12"
                Background="#26FFFFFF"
                CornerRadius="10">

                <StackPanel>
                    <TextBlock
                        Text="MAYHEM"
                        Foreground="#90FFFFFF"
                        FontSize="11"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        x:Name="MayhemModifierText"
                        Margin="0,4,0,0"
                        Foreground="White"
                        FontSize="14"/>

                    <TextBlock
                        x:Name="StatusText"
                        Margin="0,4,0,0"
                        Foreground="#B8FFFFFF"
                        FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

    </Border>
</Window>